# 复制为 .env 后按需修改：cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=taskdb

# 后端的 DATABASE_URL 由 docker-compose 依据上面三项自动拼装：
#   postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# 只有脱离 compose、在本机直接运行后端时才需要手动设置 DATABASE_URL。

# ---------- JWT ----------
# 生产环境务必替换为足够长的随机串，例如：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# ---------- 初始管理员 ----------
# 仅在数据库中尚无任何管理员时生效，之后修改此处不会影响已有账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
